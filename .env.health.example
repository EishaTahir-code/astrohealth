# Template for .env.health (safe to commit, no real key).
# Copy this file to .env.health and replace the example text with your Groq key (it starts with gsk_).
# This key runs the Health assistant and the doctors' AI summary.
# The server reads this key. NEVER rename it to start with VITE_ :
# Vite copies VITE_ variables into the browser, where anyone can read them.
GROQ_API_KEY=your-groq-key-here
# Optional: choose a different Groq model
# GROQ_MODEL=openai/gpt-oss-120b
