# Template for .env.medication (safe to commit, no real key).
# Copy this file to .env.medication and fill in the key.
# This is the Groq key for AI 2 (Medication Assistant). It can be the same key as .env.health.
# The server reads this key. NEVER rename it to start with VITE_ :
# Vite copies VITE_ variables into the browser, where anyone can read them.
GROQ_API_KEY=your-groq-key-here
# Optional: choose a different Groq model
# GROQ_MODEL=llama-3.3-70b-versatile
